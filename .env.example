# ── Eng-Mart frontend environment ──────────────────────────────────────────
# Copy to .env.local for development, or set these as real environment
# variables on the production host. .env.local is gitignored.

# Django REST API root, including the /api suffix.
#   dev  : http://localhost:8000/api
#   prod : https://api.eng-mart.com/api
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# ⚠ THE MOST IMPORTANT VARIABLE ON THIS LIST FOR SEO.
#
# It is the origin used for every canonical <link>, every Open Graph URL,
# every entry in sitemap.xml and the Host line in robots.txt. If a production
# build ships with the localhost value, Google is told the canonical home of
# every page is localhost and the site drops out of the index.
#
# No trailing slash. Must be https in production.
#   dev  : http://localhost:3000
#   prod : https://www.eng-mart.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Clerk brokers "Continue with Google". Must be the SAME Clerk instance as
# CLERK_PUBLISHABLE_KEY / CLERK_SECRET_KEY in backend/.env, or the backend
# rejects the token on the issuer check.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
