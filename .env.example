# ── Eng-Mart frontend environment ──────────────────────────────────────────
# Copy to .env.local for development, or set these as real environment
# variables on the production host. .env.local is gitignored.

# Django REST API root, including the /api suffix.
#   dev  : http://localhost:8000/api
#   prod : https://api.eng-mart.com/api
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# ⚠ THE MOST IMPORTANT VARIABLE ON THIS LIST FOR SEO.
#
# It is the origin used for every canonical <link>, every Open Graph URL,
# every entry in sitemap.xml and the Host line in robots.txt. If a production
# build ships with the localhost value, Google is told the canonical home of
# every page is localhost and the site drops out of the index.
#
# No trailing slash. Must be https in production.
#   dev  : http://localhost:3000
#   prod : https://www.eng-mart.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Clerk brokers "Continue with Google". Must be the SAME Clerk instance as
# CLERK_PUBLISHABLE_KEY / CLERK_SECRET_KEY in backend/.env, or the backend
# rejects the token on the issuer check.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me

# ── Analytics & Search Console (optional, but you are blind without them) ──
#
# Both are read at BUILD time (NEXT_PUBLIC_*), so setting them in the Vercel
# dashboard only takes effect on the next deploy — a redeploy is required.
# Leave either blank and nothing is emitted at all: no script tag, no meta tag.

# Google Analytics 4 measurement ID — visitor counts, traffic sources, behaviour.
# Defaults to the live property (G-QYRWW3QT5T) in components/analytics.tsx, so
# this only needs setting to point a fork at a DIFFERENT property.
# Get it from analytics.google.com -> Admin -> Data Streams -> your web stream.
NEXT_PUBLIC_GA_ID=

# Google Search Console ownership token — search queries, rankings, index errors.
# Defaults to the live token in app/layout.tsx; only set this for another domain.
# Get it from search.google.com/search-console -> add property -> "HTML tag".
# Paste ONLY the content value, not the whole <meta> element.
# e.g. for <meta name="google-site-verification" content="abc123..." />
#      set NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=abc123...
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# ── Storefront cache purge ─────────────────────────────────────────────────
#
# Shared secret that lets the Django backend purge this deployment's rendered
# page cache after a catalog write, so an edited product appears immediately
# instead of two or three reloads later.
#
# Set the SAME value here and as REVALIDATE_SECRET in the Render dashboard.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
#
# Leave blank and /api/revalidate returns 503; pages then fall back to their
# 120-second timed expiry, which still works but is not instant.
REVALIDATE_SECRET=
